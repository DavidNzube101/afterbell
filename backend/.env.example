# Chain and contract configuration
NEAR_NETWORK=testnet
NEAR_TESTNET_RPC_URL=https://near-testnet.drpc.org/
NEAR_TESTNET_TX_RPC_URL=https://rpc.testnet.fastnear.com
NEAR_RPC_URL=
NEAR_TX_RPC_URL=
A1_CONTRACT_ID=afterbellfx-dev-faucet.testnet
NEAR_USDC_TOKEN_ID=3e2210e1184b45b64c8a434c0a7e7b23cc04ea7eb7a6c3c32520d03d4afcb8af
INDEXER_TX_API_URL=https://tx.test.fastnear.com

# PostgreSQL transaction-pooler connection string
DATABASE_URL=
# Optional. Defaults to DATABASE_URL; point it at the landing waitlist database if separate.
WAITLIST_DATABASE_URL=

# HTTP API configuration (Render supplies PORT in production)
PORT=8080
# Set true on the deployed API service to run the C++ indexer on a background thread.
INDEXER_ENABLED=false
# Optional; relative to the service working directory. Defaults to the bundled registry.
# MARKET_REGISTRY_PATH=rh_stocks_addresses.json

# Required only for the first run with an empty indexer database.
# A1 testnet deployment block; replace if deploying A1 to another account/network.
INDEXER_START_BLOCK=274456124
INDEXER_FINALITY_LAG_BLOCKS=1000
INDEXER_RESCAN_OVERLAP_BLOCKS=10000
INDEXER_POLL_INTERVAL_MS=5000

# Robinhood Chain Uniswap V3 oracle publisher. Leave disabled until A1's
# oracle signer is configured and both private keys are set in the deployment.
ORACLE_ENABLED=false
ROBINHOOD_RPC_URL=
ORACLE_RELAYER_ACCOUNT_ID=afterbellfx-oracle.testnet
ORACLE_RELAYER_PRIVATE_KEY=
ORACLE_SIGNER_PRIVATE_KEY=
ORACLE_POLL_INTERVAL_MS=15000
ORACLE_TWAP_WINDOW_SECONDS=300
# Quote signer and transaction relay for owner-authorized A1 perp opens.
# The quote key is an EVM secp256k1 private key (32-byte hex); never commit it.
PERP_TRADING_ENABLED=false
PERP_QUOTE_SIGNER_PRIVATE_KEY=
PERP_TRADE_FEE_BPS=10
# First-time owner registration uses this NEAR storage sponsorship (maximum 0.01 NEAR).
OWNER_REGISTRATION_STORAGE_DEPOSIT_YOCTO=10000000000000000000000
# Agent records require additional NEAR storage credit (maximum 0.05 NEAR).
AGENT_RECORD_STORAGE_CREDIT_TARGET_YOCTO=50000000000000000000000
# Optional paths; default to the bundled registries below backend/.
# MARKET_REGISTRY_PATH=rh_stocks_addresses.json
# ROBINHOOD_POOL_REGISTRY_PATH=rh_uniswap_pools.json
